# ==============================================================================
# TuneFlow Headless Media Server - Environment Configuration Template
# Standard Location: /etc/tuneflow/tuneflow.env
# File Permissions: 0600 (chmod 600 /etc/tuneflow/tuneflow.env)
# Documentation: https://github.com/tamld/tuneflow
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0

# Storage & Persistence Configuration (POSIX Paths)
# TuneFlow is storage-agnostic and functions on any POSIX-compliant filesystem
# (e.g. ext4, XFS, Btrfs, ZFS, APFS, NFS, SMB).
DATA_DIR=/var/lib/tuneflow/data
DOWNLOADS_DIR=/var/lib/tuneflow/downloads
TEMP_DIR=/var/lib/tuneflow/temp
DB_PATH=/var/lib/tuneflow/data/tuneflow.db

# Storage Management & Quota Limits
MAX_STORAGE_MB=10240
DOWNLOAD_TTL_HOURS=72
MAX_DOWNLOADS=3
MAX_CONVERSIONS=2
MAX_RETRIES=3

# Guest Playback Limits
GUEST_MAX_LISTEN_SEC=1800
GUEST_COOLDOWN_SEC=3600

# Media Downloader Configuration
# YTDLP_COOKIES_PATH=/etc/tuneflow/cookies.txt
# YTDLP_PROXY=socks5://127.0.0.1:1080
# YTDLP_EXTRACTOR_ARGS=

# Security & Access Control
ADMIN_PASSWORD=admin
# ALLOWED_CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
